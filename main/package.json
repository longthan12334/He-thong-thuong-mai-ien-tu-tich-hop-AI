{
  "name": "dm-fashion-mall-core",
  "version": "1.0.0",
  "description": "Core E-Commerce Backend and Frontend Portal built with TypeScript",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/database/migrator.ts up",
    "migrate:reset": "tsx src/database/migrator.ts reset",
    "seed": "tsx src/database/migrator.ts seed",
    "test": "tsx tests/e2e.test.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.4",
    "@types/nodemailer": "^6.4.15",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}

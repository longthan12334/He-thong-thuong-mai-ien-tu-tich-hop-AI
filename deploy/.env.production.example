# Cổng dịch vụ
BACKEND_PORT=5000
FRONTEND_PORT=3001

# Tên miền chính thức của Website (Thay your-domain.com bằng tên miền của bạn)
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# Google Gemini AI API Key (Trợ lý Stylist & Viết mô tả SP)
GEMINI_API_KEY=your_gemini_api_key_here

# Khóa bảo mật JWT Token Authentication (Chuỗi ký tự ngẫu nhiên bảo mật cao)
Jwt__Key=AethelgardSuperSecretProductionKey2026NguyenDucManhSecureKey9999!
Jwt__Issuer=AethelgardMall
Jwt__Audience=AethelgardMallClients

# Cấu hình Môi trường
ASPNETCORE_ENVIRONMENT=Production
NODE_ENV=production

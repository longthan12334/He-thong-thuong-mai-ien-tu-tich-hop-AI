{
  "name": "httmdt-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Backend Hệ thống Thương mại Điện tử tích hợp AI — Nhóm 2, lớp 68CS3",
  "main": "src/server.js",
  "engines": { "node": ">=18.17" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "db:schema:pg": "psql -d $DB_NAME -f database/01_schema_sprint2_postgres.sql",
    "db:seed:pg": "psql -d $DB_NAME -f database/02_seed_data_postgres.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0",
    "sequelize": "^6.37.3"
  }
}

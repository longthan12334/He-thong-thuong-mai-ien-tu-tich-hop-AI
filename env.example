# ---- Máy chủ ----
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ---- Cơ sở dữ liệu ----
# DB_DIALECT nhận: mysql | postgres
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecom
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# ---- JWT ----
# Bắt buộc đổi hai chuỗi bí mật này trước khi triển khai thật
JWT_ACCESS_SECRET=doi_chuoi_nay_thanh_chuoi_ngau_nhien_64_ky_tu
JWT_REFRESH_SECRET=doi_chuoi_nay_thanh_mot_chuoi_khac_64_ky_tu
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=httmdt-api

# ---- Bảo mật ----
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---- Frontend ----
# Các origin được phép gọi API, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3001
